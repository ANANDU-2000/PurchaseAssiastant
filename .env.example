# =============================================================================
# Harisree / HEXA Purchase Assistant — Environment template
# Copy to backend/.env and fill secrets. Never commit real keys.
# =============================================================================

# --- App ---
APP_ENV=development                # development | production | test
APP_NAME=hexa-purchase-assistant
APP_URL=http://localhost:8000       # Public API URL
ADMIN_URL=http://localhost:5173     # Admin SPA origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8082,http://127.0.0.1:8082,http://localhost:7358,http://127.0.0.1:7358

# --- Database ---
# Production: plain Postgres URL to self-hosted or hosted DB.
# Local: postgresql+asyncpg://user:password@localhost:5432/hexa
# Quick local (no Postgres): sqlite+aiosqlite:///./hexa_dev.db + HEXA_USE_SQLITE=1
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hexa
HEXA_USE_SQLITE=                   # Set to 1 to use SQLite (local dev only)
DATABASE_SSL=                      # Set to true to enable SSL for Postgres connection
# Pool connection tuning (optional):
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=15
# DATABASE_COMMAND_TIMEOUT=45
# DATABASE_CONNECT_TIMEOUT=15

# --- Redis ---
# No local Redis: OTP/state fall back to in-memory on single instance.
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=                         # Unset = in-memory fallback

# --- Auth / JWT ---
JWT_SECRET=change-me-min-32-chars-dev-only
JWT_REFRESH_SECRET=change-me-min-32-chars-refresh-dev
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
GOOGLE_OAUTH_CLIENT_IDS=           # Comma-separated OAuth client IDs for Google Sign-In

# --- OTP (dev defaults; tighten in production) ---
DEV_RETURN_OTP=true                # Always return the same OTP in dev
DEV_OTP_CODE=000000
OTP_PROVIDER=twilio
OTP_API_KEY=
OTP_SENDER_ID=HEXA
OTP_REQUESTS_PER_MINUTE_PER_IP=10

# --- AI / LLM (POST /v1/businesses/{id}/ai/chat) ---
# Set AI_PROVIDER to openai | groq | gemini | openrouter and provide the matching key.
# stub = regex-only (no external API calls) — safe for dev.
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL_PARSE=gpt-4.1-mini    # or OPENAI_MODEL
OPENAI_MODEL_SUMMARY=gpt-4.1-mini
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
ENABLE_AI=true

# --- Super-admin ---
SUPERADMIN_BOOTSTRAP_EMAIL=        # First registered user with this email becomes super-admin
ADMIN_API_TOKEN=                   # Static Bearer token for machine auth (/v1/admin/*)

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
HTTP_SLOW_REQUEST_WARNING_MS=500   # Log WARNING when any HTTP request exceeds this (ms)
HTTP_PROPAGATE_REQUEST_ID=true
HTTP_ACCESS_LOG_ALL=false          # Noisy; enable briefly for debugging
METRICS_TOKEN=

# --- Runtime overrides ---
TRUSTED_HOSTS=                     # Comma-separated; empty = disabled
SEED_DATA_DIR=                     # Override seed JSON location
ALLOW_PUBLIC_REGISTRATION=false

# --- Feature flags ---
ENABLE_REALTIME=true
ENABLE_OCR=false
ENABLE_VOICE=false

# --- Optional TTL overrides (seconds) ---
# CACHE_TTL_STOCK_LIST=30
# CACHE_TTL_HOME_DASHBOARD=60
# CACHE_TTL_CATALOG_ITEMS=120
# CACHE_TTL_PURCHASE_LIST=30
# CACHE_TTL_STOCK_SHELL=30
