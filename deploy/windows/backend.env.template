# Copy to C:\hexa\config\backend.env and fill in. NEVER commit the filled file.
# The deploy script copies it to <release>\backend\.env (read by pydantic Settings).
# Restrict access:  icacls C:\hexa\config /inheritance:r /grant:r "SYSTEM:(OI)(CI)F" "Administrators:(OI)(CI)F"

APP_ENV=production
APP_URL=https://api.harisreeagency.online
LOG_LEVEL=INFO

# Local PostgreSQL on this server (listen on localhost only; no public port)
DATABASE_URL=postgresql+asyncpg://hexa_app:CHANGE_ME@127.0.0.1:5432/hexa
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=15

# Frontend origins allowed by CORS (comma separated, no trailing slash)
CORS_ORIGINS=https://purchase-assiastant.vercel.app

# Startup refuses to boot in production if these are weak or still "change-me" (>= 32 chars each)
JWT_SECRET=CHANGE_ME_GENERATE_64_RANDOM_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_64_RANDOM_CHARS
DEV_RETURN_OTP=false
ALLOW_PUBLIC_REGISTRATION=false
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME

# Migrations are run explicitly by deploy-release.ps1 after a backup. Keep boot-time migration off.
AUTO_MIGRATE=0

# Optional (leave unset until needed)
# SENTRY_DSN=
# REDIS_URL=redis://127.0.0.1:6379/0
# RATE_LIMIT_BACKEND=redis
# REALTIME_BACKEND=redis
# OPENAI_API_KEY=
# GOOGLE_OAUTH_CLIENT_IDS=
