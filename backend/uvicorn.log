CREATE TABLE report_saved_views (
	id CHAR(32) NOT NULL, 
	business_id CHAR(32) NOT NULL, 
	user_id CHAR(32) NOT NULL, 
	name VARCHAR(120) NOT NULL, 
	tab VARCHAR(32) NOT NULL, 
	filters_json JSON NOT NULL, 
